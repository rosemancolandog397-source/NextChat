# Place real values only in Netlify Environment Variables (Builds + Functions).
# This file is documentation; Next.js does not load .env.example automatically.
OPENAI_API_KEY=
BASE_URL=https://openrouter.ai/api/v1
SERVER_ONLY_API_KEY=1
AI_ALLOWED_MODEL=deepseek/deepseek-v4.1-flash-1017
AI_BUDGET_REDIS_REST_URL=
AI_BUDGET_REDIS_REST_TOKEN=
AI_BUDGET_NAMESPACE=nextchat-production
AI_REQUESTS_PER_MINUTE=6
AI_REQUESTS_PER_DAY=100
AI_MAX_BODY_BYTES=131072
AI_MAX_INPUT_CHARS=20000
AI_MAX_OUTPUT_TOKENS=4096
# Optional invitation code. Blank permits anonymous use of the shared budget.
CODE=
