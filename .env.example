# Public deployment defaults to BYOK. Set in Netlify Builds + Functions scope.
BYOK_MODE=1
# Optional server-side model and request-size policy (these are not secrets).
AI_ALLOWED_MODEL=deepseek/deepseek-v4.1-flash-1017
AI_MAX_BODY_BYTES=131072
AI_MAX_INPUT_CHARS=20000
AI_MAX_OUTPUT_TOKENS=4096
# Do NOT configure OPENAI_API_KEY, Redis tokens, SERVER_ONLY_API_KEY or CODE.
# Users enter their own OpenRouter key in the existing OpenAI settings field.
